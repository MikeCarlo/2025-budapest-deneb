{
  "data": {
    "name": "dataset"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "opacity": 0.3
      }
    },
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
       
        "opacity": {
          "condition": {
            "test": {
              "field": "__selected__",
              "equal": "off"
            },
            "value": 0
          },
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "text"
      },
      "encoding": {
        "text":{"field":"Margin__highlight",
        "format":",.2s"},
      
        "opacity": {
          "condition": {
            "test": {
              "field": "__selected__",
              "equal": "off"
            },
            "value": 0.3
          },
          "value": 1
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal"
    },
    "x": {
      "field": "Year Month",
      "type": "nominal",
      "timeUnit": "yearmonth",
      "axis": {
        "labelAngle": 0,
        "format": "%m.%Y",

        "labelFontSize": 10,
        "ticks": false,
        "title": null,
        "orient":"top"
      }
    }
  }
}