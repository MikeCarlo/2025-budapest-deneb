{
  "data": {
    "name": "dataset"
  },
  "repeat": [
    "Margin",
    "Total Cost",
    "Sales Amount"
  ], // Added "repeat" for creating multiple plots
  "columns": 1, // Specifies the layout of repeated plots
  "spec": {
    "width": 450, // Sets the width of each plot
    "height": 150, // Sets the height of each plot
    "layer": [
      {
        "mark": {
          "type": "bar",
          "opacity": 0.1,
          "color": {
            "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'" // Conditional expression for color
          }
        },
        "encoding": {
          "y": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      },
      {
        "mark": {
          "type": "bar",
          "color": {
            "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'" // Conditional expression for color
          }
        },
        "encoding": {
          "y": {
            "field": {
              "repeat": "repeat"
            }
          },
          "opacity": {
            "condition": {
              "test": {
                "field": "__selected__",
                "equal": "off"
              },
              "value": 0
            },
            "value": 1
          },
          "tooltip": [
            {
              "field": {
                "repeat": "repeat"
              },
              "type": "quantitative",
              "format": ",.0f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "size": {
            "expr": "datum['Margin']>= datum['Margin SPLY'] ? 12 : 0" // Conditional expression for size
          },
          "yOffset": -5
        },
        "encoding": {
          "text": {
            "field": {
              "repeat": "repeat"
            },
            "format": ",.3s"
          },
          "y": {
            "field": {
              "repeat": "repeat"
            }
          }
        }
      }
    ],
    "encoding": {
      "x": {
        "field": "Year Month",
        "type": "nominal",
        "timeUnit": "yearmonth",
        "axis": {
          "labelAngle": 0,
          "format": "%m.%Y",
          "tickCount": 2,
          "labelFontSize": 8,
          "ticks": false,
          "title": null
        }
      },
      "y": {
        "type": "quantitative",
        "axis": {
          "labelFontSize": 0,
          "ticks": false,
          "domain": false,
          "grid": false,
          "titleFontSize": 14
        }
      }
    }
  }
}