{
  "data": {
    "name": "dataset"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
       "opacity": 0.1,
        "color": {
          "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'" // Conditional expression for color
        }
      },
      "encoding": {
        "y": {
          "field": "Margin"
        }
      }
    },
    {     "params": [ // Added "params" section for interaction configurations
        {
          "name": "jeff",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        },
        {
          "name": "sue",
          "select": "interval"
        }
      ],
      "mark": {
        "type": "bar",
        "color": {
          "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'" // Conditional expression for color
        },
        "stroke":"#454545"
      },
      "encoding": {
        "y": {
          "field": "Margin__highlight"
        },
        "opacity": {
          "condition": {
            "test": {
              "field": "__selected__",
              "equal": "off"
            },
            "value": 0
          },
          "value": 1
        },
        "strokeWidth": { // Added "strokeWidth" encoding
          "condition": [
            {
              "param": "jeff",
              "empty": false,
              "value": 3
            },
            {
              "param": "sue",
              "empty": false,
              "value": 3
            }
          ],
          "value": 0
        },
            "tooltip": [
      {"field": "Margin", "type": "quantitative","format":",.0f"},
      {"field": "Margin SPLY", "type": "quantitative","format":",.0f"}
    ]
      }
    },
    {
      "mark": {
        "type": "text",
        "size": {
          "expr": "datum['Margin']>= datum['Margin SPLY'] ? 12 : 0" // Conditional expression for size
        },
        "yOffset": -5
      },
      "encoding": {
        "text": {
          "field": "Margin",
          "format": ",.3s"
        },
        "y": {
          "field": "Margin"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "Year Month",
      "type": "nominal",
      "timeUnit": "yearmonth",
      "axis": {
        "labelAngle": 0,
        "format": "%m.%Y",
        "tickCount": 2,
        "labelFontSize": 8,
        "ticks": false,
        "title": null
      }
    },
    "y": {
      "type": "quantitative",
      "axis": null
    }
  }
}