{
  "data": {
    "name": "dataset"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "opacity": 0.1,
        "color": {
          "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'"
        }
      },
      "encoding": {
        "y": {
          "field": "Margin"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": {
          "expr": "datum['Margin']>= datum['Margin SPLY'] ? '#ec7629' : '#b7b7b7'"
        }
      },
      "encoding": {
        "y": {
          "field": "Margin__highlight"
        },
        "opacity": {
          "condition": {
            "test": {
              "field": "__selected__",
              "equal": "off"
            },
            "value": 0
          },
          "value": 1
        },
        "tooltip": [
          {
            "field": "Margin",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "Margin SPLY",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "Margin",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <=1"
        },
        {
          "calculate": "datum['Month Name'] + ' - had the highest - margin with ' + format(datum['Margin'], ',.4s')",
          "as": "NewText"
        }
      ],
      "mark": {
        "type": "text",
        "yOffset": -35,
        "lineBreak": "-",
        "fontSize":11,
        "fontWeight":600
      },
      "encoding": {
        "text": {
          "field": "NewText"
        },
        "y": {
          "field": "Margin"
        }
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "Year Month",
      "type": "nominal",
      "timeUnit": "yearmonth",
      "axis": {
        "labelAngle": 0,
        "format": "%m.%Y",
        "tickCount": 2,
        "labelFontSize": 8,
        "ticks": false,
        "title": null
      }
    },
    "y": {
      "type": "quantitative",
      "axis": null
    }
  }
}